<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090511">
<meta name="description" content="A little celebration of lights awaits you. Happy Diwali!">
<title>A Diwali Celebration ✨</title>
<style>
:root{--gold:#ffd77a;--cream:#fff3d2;--bg:#090511}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:var(--bg);color:var(--cream);font-family:Georgia,"Times New Roman",serif}
body{overflow:hidden}
#sky{position:fixed;inset:0;width:100%;height:100%;z-index:0}
.vignette{position:fixed;inset:0;z-index:1;pointer-events:none;background:radial-gradient(ellipse at center,transparent 20%,rgba(3,1,9,.45) 100%)}
main{position:relative;z-index:2;min-height:100svh;display:grid;place-items:center;padding:24px;text-align:center}
.panel{width:min(680px,100%);display:flex;flex-direction:column;align-items:center;gap:18px;transition:opacity 1s,transform 1s}
.eyebrow{font:600 11px/1.4 system-ui,sans-serif;letter-spacing:.42em;text-transform:uppercase;color:#e8bd68}
h1{font-size:clamp(42px,10vw,82px);line-height:.98;margin:0;font-weight:400;letter-spacing:-.045em;color:var(--gold);text-shadow:0 0 24px #ffb52c66,0 0 70px #ff8c2450}
.subtitle{font-size:clamp(16px,4vw,21px);line-height:1.6;color:#f5e8cb;max-width:490px;margin:0}
.lamp-wrap{height:145px;width:180px;display:grid;place-items:center;position:relative;margin:2px 0}
.lamp-glow{position:absolute;width:125px;height:100px;border-radius:50%;background:#ff9e27;filter:blur(35px);opacity:.2;animation:pulse 2.4s infinite alternate}
.flame{position:absolute;top:7px;width:22px;height:43px;border-radius:80% 10% 70% 70%;transform:rotate(2deg);background:radial-gradient(ellipse at 50% 72%,#fff9c8 0 18%,#ffdb61 35%,#ff8b22 70%,transparent 72%);filter:drop-shadow(0 0 12px #ffae37);animation:flicker .14s infinite alternate}
.lamp{position:absolute;bottom:17px;width:126px;height:43px;border-radius:10% 10% 55% 55%/15% 15% 90% 90%;background:linear-gradient(180deg,#ffd47b,#a84c1b 65%,#54200f);box-shadow:inset 0 5px 8px #fff4a766,0 13px 24px #0009}
.lamp:before{content:"";position:absolute;top:-7px;left:5px;width:116px;height:14px;border-radius:50%;background:linear-gradient(90deg,#9d4219,#ffe09a,#a94d1c)}
.lamp:after{content:"";position:absolute;left:23px;right:23px;top:9px;height:3px;border-radius:50%;background:#ffe5a5aa}
button{border:1px solid #e8bd68;background:linear-gradient(135deg,#ffe6a1,#d99837);color:#281306;padding:15px 27px;border-radius:999px;font:700 12px system-ui,sans-serif;letter-spacing:.16em;text-transform:uppercase;cursor:pointer;box-shadow:0 0 25px #f9ae3c38;transition:transform .2s,box-shadow .2s}
button:hover{transform:translateY(-2px);box-shadow:0 0 34px #f9ae3c70}
button:focus-visible{outline:3px solid white;outline-offset:4px}
.hidden{display:none!important}
.greeting{opacity:0;transform:translateY(18px);transition:opacity 1.3s,transform 1.3s}
.greeting.show{opacity:1;transform:translateY(0)}
.small{font:12px/1.6 system-ui,sans-serif;color:#c9b99d;letter-spacing:.06em}
.footer{position:fixed;z-index:2;bottom:15px;left:0;right:0;text-align:center;font:10px system-ui,sans-serif;letter-spacing:.2em;color:#c6a97888}
@keyframes flicker{from{transform:rotate(-4deg) scale(.96)}to{transform:rotate(4deg) scale(1.04)}}
@keyframes pulse{from{opacity:.13;transform:scale(.8)}to{opacity:.4;transform:scale(1.2)}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</head>
<body>
<canvas id="sky" aria-hidden="true"></canvas><div class="vignette"></div>
<main>
  <section class="panel" id="intro">
    <div class="eyebrow">A festival of light • joy • new beginnings</div>
    <div class="lamp-wrap" aria-hidden="true"><div class="lamp-glow"></div><div class="flame"></div><div class="lamp"></div></div>
    <h1>A little light<br>goes a long way.</h1>
    <p class="subtitle">A little celebration of lights awaits you. Ready to make this night shine?</p>
    <button id="celebrate">Tap to light up your Diwali</button>
    <div class="small">Turn your sound on for the full festive mood</div>
  </section>
  <section class="panel hidden" id="finale">
    <div class="eyebrow">May your world glow with happiness</div>
    <h1 class="greeting" id="greeting">Happy Diwali!</h1>
    <p class="subtitle greeting" id="message">May every diya bring hope, every sparkle bring joy, and every moment shine with love.</p>
    <div class="small greeting" id="signature">With warm wishes ✨</div>
    <button id="replay">Celebrate again</button>
  </section>
</main>
<div class="footer">LIGHT • LOVE • PROSPERITY</div>
<script>
(() => {
 const canvas=document.getElementById('sky'),ctx=canvas.getContext('2d');
 let w=0,h=0,rockets=[],sparks=[],running=true,lastLaunch=0,celebrating=false;
 const rand=(a,b)=>Math.random()*(b-a)+a;
 function resize(){const d=Math.min(devicePixelRatio||1,2);w=innerWidth;h=innerHeight;canvas.width=w*d;canvas.height=h*d;canvas.style.width=w+'px';canvas.style.height=h+'px';ctx.setTransform(d,0,0,d,0,0)}
 addEventListener('resize',resize);resize();
 function launch(x=rand(w*.15,w*.85),target=rand(h*.12,h*.55)){
  rockets.push({x,y:h+8,vx:rand(-1.2,1.2),vy:rand(-10,-13),tx:x,ty:target,hue:rand(28,58),trail:[]});
 }
 function burst(x,y,hue){
  const count=celebrating?100:58;
  for(let i=0;i<count;i++){const a=Math.PI*2*i/count+rand(-.04,.04),speed=rand(1.2,5.5);sparks.push({x,y,vx:Math.cos(a)*speed,vy:Math.sin(a)*speed,life:rand(48,85),max:85,hue:hue+rand(-15,15),size:rand(1,2.8),gravity:.045})}
 }
 function frame(t){
  ctx.fillStyle='rgba(9,5,17,.22)';ctx.fillRect(0,0,w,h);
  if(celebrating&&t-lastLaunch>520){launch();lastLaunch=t}
  for(let i=rockets.length-1;i>=0;i--){
   const r=rockets[i];r.trail.push({x:r.x,y:r.y});if(r.trail.length>7)r.trail.shift();
   r.x+=r.vx;r.y+=r.vy;r.vy+=.11;
   ctx.beginPath();ctx.moveTo(r.x,r.y);ctx.lineTo(r.x-r.vx*2,r.y-r.vy*2);ctx.strokeStyle=`hsla(${r.hue},100%,72%,.9)`;ctx.lineWidth=2;ctx.stroke();
   if(r.y<=r.ty||r.vy>=0){burst(r.x,r.y,r.hue);rockets.splice(i,1)}
  }
  for(let i=sparks.length-1;i>=0;i--){
   const p=sparks[i];p.x+=p.vx;p.y+=p.vy;p.vy+=p.gravity;p.vx*=.992;p.life--;
   const alpha=Math.max(0,p.life/p.max);
   ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,Math.PI*2);ctx.fillStyle=`hsla(${p.hue},100%,${65+Math.random()*20}%,${alpha})`;ctx.fill();
   if(p.life<=0)sparks.splice(i,1);
  }
  requestAnimationFrame(frame);
 }
 requestAnimationFrame(frame);
 const intro=document.getElementById('intro'),finale=document.getElementById('finale');
 function begin(){
  if(celebrating)return;celebrating=true;lastLaunch=0;
  for(let i=0;i<5;i++)setTimeout(()=>launch(rand(w*.15,w*.85),rand(h*.12,h*.5)),i*250);
  setTimeout(()=>{intro.classList.add('hidden');finale.classList.remove('hidden');setTimeout(()=>document.querySelectorAll('.greeting').forEach(el=>el.classList.add('show')),80)},1700);
  chime();
 }
 function chime(){
  try{const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;const ac=new AC();
   [523.25,659.25,783.99,1046.5].forEach((f,i)=>{const o=ac.createOscillator(),g=ac.createGain();o.type='sine';o.frequency.value=f;g.gain.setValueAtTime(.0001,ac.currentTime+i*.16);g.gain.exponentialRampToValueAtTime(.045,ac.currentTime+i*.16+.03);g.gain.exponentialRampToValueAtTime(.0001,ac.currentTime+i*.16+.45);o.connect(g);g.connect(ac.destination);o.start(ac.currentTime+i*.16);o.stop(ac.currentTime+i*.16+.5)});
  }catch(e){}
 }
 document.getElementById('celebrate').addEventListener('click',begin);
 document.getElementById('replay').addEventListener('click',()=>{celebrating=false;rockets=[];sparks=[];ctx.clearRect(0,0,w,h);finale.classList.add('hidden');intro.classList.remove('hidden');document.querySelectorAll('.greeting').forEach(el=>el.classList.remove('show'))});
 // A gentle first-screen star field
 for(let i=0;i<70;i++){const x=rand(0,w),y=rand(0,h);sparks.push({x,y,vx:0,vy:0,life:rand(25,90),max:90,hue:rand(35,55),size:rand(.4,1.2),gravity:0})}
})();
</script>
</body>
</html>
